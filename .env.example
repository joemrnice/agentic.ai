# ---------------------------------------------------------------------------
# agentic.ai configuration
# Copy to `.env` and adjust. Every variable is optional: the runtime falls back
# to safe local defaults (mock provider, no network, no shell) so that the
# project boots with zero configuration.
# ---------------------------------------------------------------------------

# Which model provider the runtime should use: mock | openai | openai-compatible | ollama
AGENTIC_PROVIDER=mock

# Model identifier passed to the provider.
AGENTIC_MODEL=mock-1

# Base URL for OpenAI-compatible HTTP providers (Ollama, vLLM, LM Studio, Azure...).
# AGENTIC_BASE_URL=http://localhost:11434/v1

# Credentials. Never commit a real key; leave empty to use the offline mock provider.
# AGENTIC_API_KEY=sk-...

# Sampling temperature (0 = deterministic, 2 = very random).
AGENTIC_TEMPERATURE=0.2

# Hard cap on reason/act iterations per run. Prevents runaway loops and spend.
AGENTIC_MAX_STEPS=8

# Per-tool execution timeout in milliseconds.
AGENTIC_TOOL_TIMEOUT_MS=15000

# Retries for read-only tools (mutating tools are never retried).
AGENTIC_MAX_TOOL_RETRIES=1

# Tool observations longer than this are truncated before entering the context window.
AGENTIC_TOOL_MAX_OUTPUT_CHARS=4000

# Log verbosity: silent | error | warn | info | debug | trace
AGENTIC_LOG_LEVEL=info

# Sandbox root for filesystem tools. Defaults to the current working directory.
# AGENTIC_WORKSPACE=/workspaces/agentic.ai

# Where long-term memory is persisted, relative to the workspace.
AGENTIC_MEMORY_DIR=memory
AGENTIC_MEMORY_LIMIT=500
AGENTIC_MEMORY_PERSIST=true

# Dangerous capabilities are opt-in.
AGENTIC_ALLOW_NETWORK=false
AGENTIC_ALLOW_SHELL=false

# Comma separated allowlists (empty = no restriction for hosts, deny-all for shell).
# AGENTIC_ALLOWED_HOSTS=api.github.com,example.com
# AGENTIC_SHELL_ALLOWLIST=ls,cat,pwd,node,npm,git
# AGENTIC_SHELL_TIMEOUT_MS=15000
